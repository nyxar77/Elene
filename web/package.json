{
  "name": "elene-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint . && prettier --check src *.json *.ts *.js",
    "format": "prettier --write src *.json *.ts *.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
